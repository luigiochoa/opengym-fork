# Copy to .env ON THE SERVER. Do not commit the resulting .env.
# Branding is injected by apply-brand.sh and these values are preserved.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
WEB_PORT=8090

INVITE_ONLY=1
ALLOW_GUEST=0
ADMIN_UIDS=

# Optional runtime hardening:
SESSION_DAYS=90
AUDIT_LOG=1
AUDIT_IP=off

