# Copy to .env in a dedicated pilot checkout; keep the existing RP_ID and ORIGIN on upgrades.
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=Fortachones Gym
TRAINER_PILOT=1
TRAINER_TIMEZONE=America/Caracas
INVITE_ONLY=1
ALLOW_GUEST=0
PASSWORD_LOGIN=1
DEFAULT_LANG=es
# Existing trainer account ID; never promote a pupil. On a fresh instance, see pack/PILOT.md.
ADMIN_UIDS=
FIRST_USER_ADMIN=0
AUDIT_LOG=1
AUDIT_IP=off
COACH_ENABLED=0
SESSION_DAYS=30
VITE_APP_NAME=Fortachones Gym
VITE_DEFAULT_LANG=es
VITE_DEFAULT_ACCENT=brand
VITE_BRAND_ACCENT=#67C00A
VITE_SOURCE_URL=https://github.com/luigiochoa/opengym-fork
